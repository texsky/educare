# ============================================================
# EduCare Solutions — .gitignore
# ============================================================

# ─── Environment files ──────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ─── Node.js ────────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ─── Logs ───────────────────────────────────────────────────
logs/
backend/logs/
*.log
*.log.*

# ─── Build outputs ──────────────────────────────────────────
dist/
build/
frontend/dist/
frontend/build/
*.tsbuildinfo

# ─── Uploads (runtime data, not source) ─────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── OS / Editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
*.iws

# ─── Docker ─────────────────────────────────────────────────
# (Dockerfiles ARE committed; only runtime artifacts are ignored)
docker-compose.override.yml

# ─── Testing ────────────────────────────────────────────────
coverage/
.nyc_output/
junit.xml

# ─── Miscellaneous ──────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
