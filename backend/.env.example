# ============================================================
# EduCare Solutions – Backend Environment Variables Template
# Copy to .env and fill in real values before running.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_VERSION=v1
SEED_DATA=true

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/educare_db
MONGO_URI=mongodb://localhost:27017/educare_db
MONGODB_URI_PROD=mongodb+srv://<user>:<password>@cluster.mongodb.net/educare_db?retryWrites=true&w=majority

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- File Upload ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5

# --- Nodemailer (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=EduCare Solutions
EMAIL_FROM_ADDRESS=no-reply@educare.com

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --- School Info (used in PDF/emails) ---
SCHOOL_NAME=EduCare International School
SCHOOL_ADDRESS=123 Education Street, Knowledge City, 000001
SCHOOL_PHONE=+91-9999999999
SCHOOL_EMAIL=info@educare.com
SCHOOL_WEBSITE=https://www.educare.com
SCHOOL_LOGO_PATH=assets/logo.png

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# --- Notification Queue ---
NOTIFICATION_QUEUE_RETRY_LIMIT=3
NOTIFICATION_QUEUE_RETRY_DELAY_MS=5000

# --- Password Reset ---
RESET_TOKEN_EXPIRES_MIN=30
FRONTEND_URL=http://localhost:3000
