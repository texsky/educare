# ============================================================
# EduCare Solutions — Root Environment Variables Example
# ============================================================
# Copy this file to .env and fill in real values.
# This file is committed to git; .env is NOT.
#
# The backend service also has its own backend/.env.example
# for local (non-Docker) development. For Docker Compose all
# variables below are injected into the backend container.
# ============================================================

# ─── MongoDB ────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_strong_password
MONGO_DB_NAME=educare
MONGODB_URI=mongodb://admin:changeme_strong_password@mongodb:27017/educare?authSource=admin
MONGO_URI=mongodb://admin:changeme_strong_password@mongodb:27017/educare?authSource=admin

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_very_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Backend App ────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:80

# ─── Email (Nodemailer) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="EduCare Solutions <noreply@educare.com>"

# ─── SMS (Twilio free trial) ────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Alternative: fast2sms (free tier — India)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# ─── File Storage ───────────────────────────────────────────
# Local filesystem is the default (uploads/ folder inside container).
# To switch to Cloudinary (free tier: 10 GB storage, 25 GB/month bandwidth):
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# To switch to Backblaze B2 (free: 10 GB storage, 1 GB/day download):
# STORAGE_PROVIDER=backblaze
# B2_APPLICATION_KEY_ID=your_key_id
# B2_APPLICATION_KEY=your_application_key
# B2_BUCKET_NAME=educare-uploads

# ─── Rate Limiting ──────────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100

# ─── School Branding (used in PDF memos) ────────────────────
SCHOOL_NAME="EduCare School"
SCHOOL_ADDRESS="123 Education Lane, Knowledge City"
SCHOOL_PHONE="+91-9876543210"
SCHOOL_EMAIL="info@educare.com"
SCHOOL_LOGO_PATH=./assets/logo.png
